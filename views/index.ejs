<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EnIssue</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <header class="bg-white shadow">
      <nav class="container mx-auto p-4 flex justify-between">
        <div>
          <a href="/" class="text-xl font-bold">EnIssue</a>
        </div>
        <div>
          <a href="/" class="mr-4">Accueil</a>
          <a href="/page1" class="text-indigo-600 font-bold">Ajouter une Issue</a>
        </div>
      </nav>
    </header>
    <main class="flex justify-center items-center">
      <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md mt-8">

        <h2 class="text-xl font-semibold mb-4">Liste des Issues</h2>
        <ul class="mb-6 space-y-2">
          <% if (issues.length > 0) { %>
            <% issues.forEach(function(issue) { %>
              <li class="border-b border-gray-200 py-2">
                <span class="font-bold"><%= issue.title %></span><br>
                <span>Créé par <%= issue.author %> le <%= issue.createdAt %></span><br>
                <span>Description : <%= issue.description %></span><br>
                <span>Statut : <%= issue.status %></span>
              </li>
            <% }); %>
          <% } else { %>
            <li>Aucune issue soumise pour le moment.</li>
          <% } %>
        </ul>
      </div>
    </main>
  </body>
</html>
